# Application Settings
APP_NAME=Zana AI Assistant
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Spotify Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
SPOTIFY_FRONTEND_REDIRECT=http://localhost:5173

# Phase 3: Speech-to-Text (also used for Phase 4 AI Brain LLM)
# Get a free Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
STT_PROVIDER=auto

# Phase 4: AI Brain — LLM model
# Uses same GROQ_API_KEY above. No additional key required.
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Playback Provider (Optional - official YouTube Data API v3 key)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# SoundCloud Audio Playback Provider (OAuth 2.1)
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret_here

